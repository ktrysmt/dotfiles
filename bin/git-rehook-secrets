#!/usr/bin/env bash
# Reinstall the dotfiles-managed git-secrets hooks into existing repositories.
#
# Git copies ~/.git-templates/git-secrets/hooks only at `git init` / `git clone`
# time, so repositories created before a template change keep the old hooks.
#
# Usage:
#   git-rehook-secrets                # the repository containing $PWD
#   git-rehook-secrets DIR [DIR...]   # every repository found under DIR
#
# A hook is replaced only when it is absent or is itself a git-secrets hook.
# Anything else -- lefthook, husky, the pre-commit framework -- is left alone
# and reported, so this never clobbers a project's own hooks.

set -euo pipefail

TEMPLATE_HOOKS="${GIT_SECRETS_TEMPLATE_HOOKS:-$HOME/.git-templates/git-secrets/hooks}"
HOOKS=(pre-commit prepare-commit-msg commit-msg)

if [[ ! -d "$TEMPLATE_HOOKS" ]]; then
  echo "template hooks not found: $TEMPLATE_HOOKS" >&2
  exit 1
fi

rehook_repo() {
  local repo="$1" hooks_dir toplevel hook dest changed=0

  hooks_dir="$(git -C "$repo" rev-parse --path-format=absolute --git-path hooks 2> /dev/null)" || return 0
  toplevel="$(git -C "$repo" rev-parse --show-toplevel 2> /dev/null || echo "$repo")"
  mkdir -p "$hooks_dir"

  for hook in "${HOOKS[@]}"; do
    dest="${hooks_dir}/${hook}"
    if [[ -e "$dest" ]] && ! grep -q 'git secrets' "$dest"; then
      echo "skip  ${toplevel}: foreign ${hook} left untouched"
      continue
    fi
    if [[ -e "$dest" ]] && cmp -s "${TEMPLATE_HOOKS}/${hook}" "$dest"; then
      continue
    fi
    cp "${TEMPLATE_HOOKS}/${hook}" "$dest"
    chmod +x "$dest"
    changed=1
  done

  if [[ $changed -eq 1 ]]; then
    echo "ok    ${toplevel}"
  fi
}

sweep_dir() {
  local root="$1" gitpath
  while IFS= read -r -d '' gitpath; do
    rehook_repo "$(dirname "$gitpath")"
  done < <(find "$root" -name .git -prune -print0 2> /dev/null)
}

main() {
  if [[ $# -eq 0 ]]; then
    rehook_repo "$PWD"
    return
  fi
  local root
  for root in "$@"; do
    if [[ ! -d "$root" ]]; then
      echo "not a directory: $root" >&2
      continue
    fi
    sweep_dir "$root"
  done
}

main "$@"
