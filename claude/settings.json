{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": false,
  "deniedMcpServers": [],
  "disableBundledSkills": false,
  "disableClaudeAiConnectors": false,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "breakthrough@ktrysmt": false,
    "codex@openai-codex": false,
    "drawio@drawio": true,
    "eli5@claude-community": false,
    "fablish@ktrysmt": false,
    "llmwiki@ktrysmt": false,
    "stop-slop-ja@ktrysmt": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "repo": "anthropics/claude-plugins-community",
        "source": "github"
      }
    },
    "drawio": {
      "source": {
        "repo": "jgraph/drawio-mcp",
        "source": "github"
      }
    },
    "ktrysmt": {
      "source": {
        "repo": "ktrysmt/claude-plugins",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-window-claude-status.sh notification",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-window-claude-status.sh thinking",
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/markdown-lint.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/sandbox-auto-allow.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-window-claude-status.sh notification",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/agent-browser-domains.sh",
            "statusMessage": "Checking bot-walled domains...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|WebFetch"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/gh-metadata-confirm.sh",
            "statusMessage": "Checking gh tracker metadata...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "continueOnBlock": true,
            "if": "Edit(//**/*.md)",
            "prompt": "You review Japanese prose that the assistant is about to write to a file. Hook input: $ARGUMENTS\n\nThe text being written is tool_input.content for Write, tool_input.new_string for Edit, and every tool_input.edits[].new_string for MultiEdit. If that text contains no Japanese prose, respond {\"ok\": true}.\n\nOtherwise check only the prose; ignore fenced code, inline code, URLs, file paths, and text inside 「」 that is quoted as an example. The goal is text a reader understands in one pass. Flag only clear problems of these kinds:\n1. Missing role: a sentence omits its actor or the object of a transitive verb, unless the actor is the assistant itself or the object is named in the same or the previous sentence; or a pronoun or bare count has no referent in the same or the previous sentence.\n2. Term collision: a katakana word that is also the name of a Claude Code feature (エージェント, スキル, タスク, フック, プラン, チーム, メモリ, ワークフロー, アーティファクト) is used for the general concept; the fix is a plain Japanese word (作業, 計画).\n3. Calque or idiom: an English common noun translated word for word (表面, 着地, 所有, figurative 経路), or a business idiom or metaphor (筋が良い, 腹落ち, 刺さる, 寄せる, 握る).\n4. Padding: a sentence or phrase that can be removed without changing the meaning, or a point stated twice.\nWhen unsure, allow.\n\nIf nothing is flagged, respond {\"ok\": true}. Otherwise respond {\"ok\": false, \"reason\": \"...\"}. Begin the reason with: The file was not written. Rewrite the flagged sentences and retry the same tool call. Then, for each violation, quote the sentence, name the rule number, and state in one sentence what is wrong and which fix the rule calls for. Do not write a rewritten sentence; the assistant rewrites it following ~/.claude/rules/japanese.md.",
            "statusMessage": "Reviewing Japanese prose...",
            "timeout": 30,
            "type": "prompt"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-window-claude-status.sh reset",
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/cleanup-short-sessions.sh",
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/session_summarizer_wrapper.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-window-claude-status.sh start",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-window-claude-status.sh done",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-window-claude-status.sh thinking",
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/japanese-reminder.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
