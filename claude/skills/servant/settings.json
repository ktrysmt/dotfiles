{
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git commit *)",
      "Bash(git * commit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh api *)",
      "Bash(*jira.sh*)",
      "Bash(*confluence.py put *)",
      "Bash(*confluence.py post *)",
      "mcp__slack__slack_send_message",
      "mcp__slack__slack_send_message_draft",
      "mcp__slack__slack_schedule_message",
      "mcp__slack__slack_create_canvas",
      "mcp__slack__slack_update_canvas"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/skills/servant/guard.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
